# conatusipsi 환경변수 — .env.local로 복사 후 실제 값 입력
# Production/Preview 배포는 Vercel 프로젝트 환경변수(Settings → Environment Variables) 사용.
# ⚠️ 새 환경변수를 추가하면 production·preview·development 3개 타깃 모두에 등록할 것.
#    (특히 NEXT_PUBLIC_SUPABASE_* 가 preview 에 누락되면 미리보기 배포에서 로그인 전면 불능)

# ─── Supabase (DB / Auth / Storage) — 필수 ───
# Supabase Dashboard → Project Settings → API
# URL·anon 키는 브라우저에 노출됨(NEXT_PUBLIC_) — RLS 로 행 보안. anon 키 노출은 정상.
# service_role 키는 서버 전용 — 절대 클라이언트/번들/응답 본문에 노출 금지(RLS 우회 권한).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# (선택) Supabase Management API — CLI/마이그레이션/시드 스크립트용 personal access token
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ─── Anthropic Claude API — 필수(AI 카운슬러·분석) ───
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── NEIS (교육행정정보시스템) 학교기본정보 API ───
# https://open.neis.go.kr — 회원가입 후 인증키 발급. 가입·분석 폼의 고등학교
# 자동완성에 사용. 1일 호출 한도 존재 (대략 5,000~10,000회) — lib/api/neis.ts
# 에서 검색어 기반 메모리 캐싱으로 동일 query 재호출 방지.
# 서버 전용(NEXT_PUBLIC_ 아님) — 클라이언트는 자체 /api/neis/highschools 프록시 호출.
NEIS_API_KEY=

# ─── KCUE / 대학알리미 (academyinfo.go.kr) OpenAPI ───
# docs/setup.md §2.5 — 공공데이터포털(data.go.kr)에서 5종 dataset 활용신청 후 발급.
# 같은 사용자에게는 5개 dataset 모두 동일한 키가 발급되므로 공통 KCUE_API_KEY 하나만 채우면 된다.
# (HTTPS 가 키를 거부하므로 클라이언트는 HTTP 로 호출 — kcue-client.ts 의 BASE_URL 참조)
KCUE_API_KEY=
# (선택) service 별 키를 따로 쓰는 경우 — 위 KCUE_API_KEY 보다 우선 적용
# KCUE_API_KEY_BASIC_INFO=
# KCUE_API_KEY_DEPARTMENTS=
# KCUE_API_KEY_STUDENT_STATUS=
# KCUE_API_KEY_FINANCE=
# KCUE_API_KEY_FACULTY=

# ─── Toss Payments (결제) ───
# https://app.tosspayments.com/
TOSS_SECRET_KEY=test_sk_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_...

# ─── 카카오 OAuth ───
# https://developers.kakao.com/console/app — REST API 키 + 보안(Client Secret).
# 실제 OAuth 활성/비활성은 Supabase Dashboard → Authentication → Providers → Kakao 에서 관리.
# (Supabase redirect URL: https://<project-ref>.supabase.co/auth/v1/callback 를 카카오 콘솔에 등록)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ─── 구글 OAuth (현재 비활성 — LoginView 의 GOOGLE_OAUTH_ENABLED 와 동기화) ───
# 활성화하려면 Google Cloud Console 에서 OAuth client ID/secret 발급 →
# Supabase Dashboard → Authentication → Providers → Google 활성화 →
# app/login/LoginView.tsx 의 GOOGLE_OAUTH_ENABLED 를 true 로 변경.
# (키 자체는 Supabase Provider 설정에 저장되므로 여기엔 별도 env 불필요)

# ─── 입시 학년도 (선택, 권장) ───
# 검색·추천·비교·플래너·학과 상세가 조회할 학년도(department_admissions.year).
# 미설정 시 lib/admission/current-year.ts 가 시즌(3월 롤오버) + 적재 상한으로 폴백한다.
# ETL 로 새 학년도를 적재한 뒤 이 값을 올리고 재배포하는 것이 정식 갱신 절차.
# (Vercel production/preview/development 3개 타깃 모두 등록)
NEXT_PUBLIC_ADMISSION_YEAR=2027

# ─── Google Analytics (선택) ───
# 값이 없으면 Analytics 컴포넌트는 consent 배너까지 렌더하지 않음.
NEXT_PUBLIC_GA_ID=

# ─── Sentry (선택, 에러 트래킹) ───
# DSN 비어 있으면 sentry.{server,edge}.config.ts + instrumentation-client.ts 에서 init no-op.
# https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (CI 빌드 시에만 필요; 로컬은 비워둬도 됨)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Resend (이메일 발송) — 필수(가입 confirmation 메일) ───
# Supabase Auth SMTP 가 본 키로 가입 confirmation·비밀번호 reset·magic link 메일 발송.
# transactional 메일(영수증·리포트) 도 동일 키로 서버 SDK 직접 호출 가능.
# https://resend.com/api-keys — Full access 키 발급 (RESEND_API_KEY).
# ⚠️ Supabase Dashboard → Project Settings → Auth → SMTP 에 smtp.resend.com 연결 필요.
RESEND_API_KEY=

# ─── 마스터 계정 (운영진 — 모든 plan 한도 우회) ───
# 서버 전용. 쉼표 구분 이메일 목록. 빈 값이면 마스터 없음.
# 이전 NEXT_PUBLIC_MASTER_EMAILS 지양 — 클라이언트 번들에 이메일 목록이 노출됨.
MASTER_EMAILS=admin@example.com,owner@example.com

# ─── 사업자 정보 (전자상거래법 통신판매업 표시 의무) ───
# 출시 전 사업자등록 + 통신판매업 신고 후 입력. 미입력 시 footer는 placeholder 노출.
# 핵심 4개 필드(NAME/REPRESENTATIVE/REGISTRATION_NUMBER/TELECOM_NUMBER)가 모두 채워져야
# 실제 정보로 간주됨. NEXT_PUBLIC_ prefix는 클라이언트 노출 footer에서 읽기 위한 것이며,
# 사업자 정보 자체가 공개 의무 정보라 보안 이슈 없음.
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_REPRESENTATIVE=
NEXT_PUBLIC_BIZ_REGISTRATION_NUMBER=
NEXT_PUBLIC_BIZ_TELECOM_NUMBER=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_EMAIL=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER=
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER_EMAIL=

# ─── 앱 스토어 URL (출시 후 입력) ───
# /pricing의 일반 유저 CTA가 이 URL로 다운로드 유도. 빈 값이면 "#" fallback.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# ─── Vercel (선택) — CLI/스크립트에서 배포·env 관리 시 ───
# https://vercel.com/account/tokens
VERCEL_TOKEN=
