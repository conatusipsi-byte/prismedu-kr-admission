/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.local.example
!.env.example

# Local-only data files (kept out of repo to avoid leaking sensitive prep data)
/prism_master.json

# firebase
firebase-debug.log
firestore-debug.log
.firebase/
# Firebase Admin SDK 서비스 계정 키 — 절대 커밋 금지
*-firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# prismedu.kr 참고 코드 — 로컬 참조용, deploy 대상 아님
/_prism_reference/

# KCUE API probe 결과 (로컬 dev 전용 — 깨끗한 fixture 는 __tests__/__fixtures__ 에 별도 보관)
/_kcue-samples/

# 원본 입력 데이터 (모집요강 PDF · KICE 통계 CSV · HWPX) — 로컬 dev 전용
# 파싱 산출물은 data/parsed-admissions/ 또는 Supabase 에 적재됨.
/university/
/univ/
# 한국교육시설안전원 학교위치 CSV (high_schools seed 원본 — DB 적재 후 불필요, ~3.6MB)
/한국교육시설안전원_*.csv

# Claude Code local session state
/.claude/

# Supabase CLI local temp/link state
/supabase/.temp/

# OS
Thumbs.db
desktop.ini